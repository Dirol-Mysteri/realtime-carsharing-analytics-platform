[sqlfluff]
dialect = clickhouse
templater = dbt
max_line_length = 120

[sqlfluff:templater:dbt]
project_dir = ./dbt_platform
profiles_dir = ./dbt_platform

[sqlfluff:indentation]
tab_space_size = 4

# Отключаем слишком строгие правила, которые часто конфликтуют с джинжой
[sqlfluff:rules]
allow_scalar = True
